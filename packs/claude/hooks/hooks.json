{
  "description": "Veldo guard: blocks merge and push attempts when the canonical gate is not green for HEAD or no proof manifest exists for HEAD.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/veldo-guard.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/space-session.py\" SessionStart",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/space-session.py\" SessionEnd",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
