#!/usr/bin/env bash
# VELDO git pre-push hook for the Cursor pack - the reliable local push gate.
#
# Cursor has no native pre-push hook, so the guaranteed enforcement of the VELDO invariant
# (no push to trunk without a passing commit-bound verdict + protected-path approval) is this
# git pre-push hook plus the CI required status check (.github/workflows/veldo-gate.yml). The
# .cursor/hooks hook gives earlier feedback but this is the gate that cannot be skipped from
# inside the editor.
#
# Enable it once per clone (git does not run a committed hook until its hooks path points here):
#   git config core.hooksPath hooks
#
# It invokes the shared engine guard (scripts/veldo-guard.sh). The guard reads the command from a
# JSON payload on STDIN (tool_input.command), NOT from an env var, so this feeds it that payload
# (git's ref list on the hook's stdin is not what the guard wants). A push is what we are gating.
set -u
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
GUARD="$ROOT/scripts/veldo-guard.sh"
if [ -f "$GUARD" ]; then
  printf '%s' '{"tool_input":{"command":"git push"}}' | bash "$GUARD"
  exit $?
fi
echo "VELDO pre-push: scripts/veldo-guard.sh not found; refusing to push without the gate." >&2
exit 1
