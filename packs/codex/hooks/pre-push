#!/usr/bin/env bash
# VELDO git pre-push hook for the Codex CLI pack - the guaranteed local push gate.
#
# Enforces the VELDO invariant (no push to trunk without a passing commit-bound verdict +
# protected-path approval) alongside the CI required status check. Enable once per clone:
#   git config core.hooksPath hooks
#
# It invokes the shared engine guard (scripts/veldo-guard.sh). The guard reads the command from a
# JSON payload on STDIN (tool_input.command), NOT from an env var, so this feeds it that payload;
# git's ref list on the hook's stdin goes to the guard in VELDO_PUSH_REFS.
set -u
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
GUARD="$ROOT/scripts/veldo-guard.sh"
if [ -f "$GUARD" ]; then
  # VELDO-0270: git's ref lines (this hook's stdin) and the remote name ($1) go to the guard, which
  # judges every commit the push sends for proof over the limit or an encoded archive.
  VELDO_PUSH_REFS="$(cat 2>/dev/null || true)"
  VELDO_PUSH_REMOTE="${1:-}"
  export VELDO_PUSH_REFS VELDO_PUSH_REMOTE
  printf '%s' '{"tool_input":{"command":"git push"}}' | bash "$GUARD"
  exit $?
fi
echo "VELDO pre-push: scripts/veldo-guard.sh not found; refusing to push without the gate." >&2
exit 1
