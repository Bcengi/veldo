--- /dev/null
+++ b/q7_lost_commit.py
@@ -0,0 +1,21 @@
+# Builder probe: a revision accept_revision rightly accepted, whose commit the bound repository later loses.
+import sys; sys.path.insert(0, sys.argv[1]); from h import *
+b, o, db, conn, acc, svc = env()
+main = g(o, 'rev-parse', 'HEAD')
+g(o, 'checkout', '-q', '-b', 'side')
+(o / 'specs').mkdir(); (o / 'specs/VELDO-0009-side.md').write_bytes(b'# side\n')
+g(o, 'add', '-A'); g(o, 'commit', '-qm', 'side')
+side = g(o, 'rev-parse', 'HEAD')
+g(o, 'checkout', '-q', '-')
+acc.accept('revision/side', 'repository', side, 'op', **SIG)
+print('side revision accepted at', side[:12])
+g(o, 'branch', '-D', 'side'); g(o, 'reflog', 'expire', '--expire=now', '--all'); g(o, 'gc', '-q', '--prune=now')
+held = subprocess.run(['git', '-C', str(o), 'cat-file', '-e', side + '^{commit}'], stderr=subprocess.DEVNULL).returncode == 0
+print('bound repository still holds it:', held)
+try:
+    r = enable(svc, first=None)
+    kind = svc.current(al.kind_id('repository', 'specification'))[1]
+    print('enable: committed, next =', kind['next'], 'floor_commits =', [c[:12] for c in kind['floor_commits']])
+    if kind['next'] <= 9: print('FINDING: VELDO-0009 is held by an accepted revision but the floor dropped it; next is', kind['next'])
+except st.StoreRefused as e:
+    print('enable: refused', e.code, e.detail)
