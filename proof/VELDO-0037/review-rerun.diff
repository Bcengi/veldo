+def make_repository(path, readme):
+    path.mkdir(); (path / 'README.md').write_bytes(readme)
+    g = lambda *a: subprocess.run(['git', '-C', str(path), *a], check=True, capture_output=True)
+    g('init', '-q'); g('add', '.'); g('-c', 'user.name=x', '-c', 'user.email=x@x', 'commit', '-qm', 'accepted')
+    return path
+def accept(conn, signing, repository, origin):
+    head = subprocess.run(['git', '-C', str(origin), 'rev-parse', 'HEAD'], check=True, capture_output=True, text=True).stdout.strip()
+    st.execute(conn, {'command_id': 'accept-' + repository, 'principal': 'op', 'operation': 'upsert_entity',
+        'nonce': 'accept-%s/n' % repository, 'artifact_digests': [], 'expected_versions': {'revision/' + repository: 0},
+        'parameters': {'entity_id': 'revision/' + repository, 'kind': 'accepted_revision', 'data': {
+            'domain_uuid': 'domain', 'repository_uuid': repository, 'commit': head, 'documents': {}, 'statuses': {}}}}, **signing)
