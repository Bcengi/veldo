    "reads.objectives": {"method": "GET", "path": "/api/v1/domains/{domain}/objectives", "required": [], "optional": []},
    "reads.proof": {"method": "GET", "path": "/api/v1/domains/{domain}/proof", "required": [], "optional": []},
    "reads.spend": {"method": "GET", "path": "/api/v1/domains/{domain}/spend", "required": [], "optional": []},
    "reads.configuration": {"method": "GET", "path": "/api/v1/domains/{domain}/configuration", "required": [], "optional": []},
    "reads.workflow": {"method": "GET", "path": "/api/v1/domains/{domain}/workflow", "required": ["workflow"], "optional": ["version"]},
