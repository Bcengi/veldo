    "workers.cap": {"method": "POST", "path": "/api/v1/domains/{domain}/workers/cap", "required": ["account", "account_version", "concurrency"], "optional": []},
    "events.read": {"method": "GET", "path": "/api/v1/domains/{domain}/events", "required": [], "optional": ["after"]},
    "events.stream": {"method": "GET", "path": "/api/v1/domains/{domain}/events/stream", "required": [], "optional": ["after"]}
  }
