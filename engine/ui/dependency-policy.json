{
  "schema": "veldo.ui_dependency_policy/v1",
  "about": "Every package the UI may install (VELDO-0145, applying VELDO-0131 AC4). Direct packages are listed with their exact registry version (taken on 2026-10-28 with npm view), license, origin and tier; every package of package-lock.json must carry an allowed license and match no denied name. The VELDO-0145 suite applies this file with control_api_ui.dependency_problems.",
  "licenses": {
    "allowed": [
      "(MPL-2.0 OR Apache-2.0)",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "BlueOak-1.0.0",
      "CC0-1.0",
      "ISC",
      "MIT",
      "MIT-0",
      "MPL-2.0",
      "OFL-1.1"
    ]
  },
  "deny": [
    {
      "name": "primevue",
      "reason": "free and paid tiers: version 5 is under the commercial PrimeUI License with a free community tier, and the vendor sells paid add-ons around version 4 (dropped by the owner, VELDO-0145 round 2)"
    },
    {
      "name": "@primevue/*",
      "reason": "free and paid tiers: version 5 is under the commercial PrimeUI License with a free community tier, and the vendor sells paid add-ons around version 4 (dropped by the owner, VELDO-0145 round 2)"
    },
    {
      "name": "@primeui/license-manager",
      "reason": "free and paid tiers: the license manager of the commercial PrimeUI License"
    },
    {
      "name": "@primeuix/themes",
      "from_major": 2,
      "reason": "free and paid tiers: themes of the commercial PrimeUI line"
    },
    {
      "name": "ag-grid-enterprise",
      "reason": "free and paid tiers"
    },
    {
      "name": "@mui/x-*-pro",
      "reason": "free and paid tiers"
    },
    {
