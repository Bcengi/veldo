  "owner_decisions": [
    {
      "name": "primevue",
      "decision": "Telegram 37228: the owner named PrimeVue 4 for the UI stack. Version 4.5.5 is MIT; the vendor's paid add-ons and the commercial version 5 are recorded as an open question in proof/VELDO-0145/OPEN.md."
    }
  ],
  "overrides": {
    "dompurify": {
      "version": "3.4.17",
      "license": "(MPL-2.0 OR Apache-2.0)",
      "why": "monaco-editor 0.57.0 pins dompurify 3.4.15, which has published advisories; 3.4.17 fixes them"
    }
  },
