    "dompurify": {
      "version": "3.4.17",
      "license": "(MPL-2.0 OR Apache-2.0)",
      "why": "monaco-editor 0.57.0 pins dompurify 3.4.15, which has published advisories; 3.4.17 fixes them"
    }
  },
