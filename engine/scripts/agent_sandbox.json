{
  "schema": "veldo.agent-sandbox/v1",
  "store": "~/.cache/veldo/gate-reuse-v2",
  "read_roots": [
    "/usr",
    "/lib",
    "/lib64",
    "/bin",
    "/sbin",
    "/etc",
    "{authority}",
    "{worktree}",
    "{scratch}"
  ],
  "write_roots": [
    "{worktree}",
    "{scratch}"
  ],
  "deny_write": [
    "{authority}"
  ],
  "seed_files": {
    "~/.gitconfig": ".gitconfig"
  },
  "clients": {
    "claude": {
      "places": {
        "home": ["CLAUDE_CONFIG_DIR", "~/.claude"],
        "state": ["CLAUDE_CONFIG_DIR", "~"]
      },
      "credentials": {
        "{home}/.credentials.json": ".claude/.credentials.json"
      },
      "seed_files": {
        "{home}/settings.json": ".claude/settings.json",
        "{home}/CLAUDE.md": ".claude/CLAUDE.md",
        "{state}/.claude.json": ".claude/.claude.json",
        "{home}/plugins/installed_plugins.json": ".claude/plugins/installed_plugins.json",
        "{home}/plugins/known_marketplaces.json": ".claude/plugins/known_marketplaces.json"
      },
      "read_links": {
        "{home}/plugins/cache": ".claude/plugins/cache",
        "{home}/plugins/marketplaces": ".claude/plugins/marketplaces",
        "{home}/plugins/synced": ".claude/plugins/synced",
        "{home}/skills": ".claude/skills",
        "{home}/agents": ".claude/agents",
        "{home}/commands": ".claude/commands"
      },
      "state_dirs": {
        "{home}/projects/{project}": ".claude/projects/{project}"
      }
    },
    "codex": {
      "places": {
        "home": ["CODEX_HOME", "~/.codex"]
      },
      "credentials": {
        "{home}/auth.json": ".codex/auth.json"
      },
      "seed_files": {
        "{home}/config.toml": ".codex/config.toml",
        "{home}/AGENTS.md": ".codex/AGENTS.md"
      },
      "read_links": {
        "{home}/skills": ".codex/skills",
        "{home}/rules": ".codex/rules",
        "{home}/plugins/cache": ".codex/plugins/cache"
      },
      "state_dirs": {
        "{home}/veldo-agent-state/{project_key}/sessions": ".codex/sessions",
        "{home}/veldo-agent-state/{project_key}/memories": ".codex/memories"
      },
      "state_files": {
        "{home}/veldo-agent-state/{project_key}/history.jsonl": ".codex/history.jsonl"
      }
    }
  },
  "project_read_roots": [
    "~/projects/webflow-ops-worktrees"
  ],
  "optional_read_roots": [
    "~/.nvm/versions/node",
    "~/.local/share/claude",
    "~/.local/share/veldo/langgraph"
  ],
  "deny_read": [
    "~/.ssh",
    "~/.cache/veldo",
    "~/.codex/auth.json",
    "~/.claude/.credentials.json"
  ]
}
