{
  "schema": "veldo.agent-sandbox/v1",
  "store": "~/.cache/veldo/gate-reuse-v2",
  "read_roots": [
    "/usr",
    "/lib",
    "/lib64",
    "/bin",
    "/sbin",
    "/etc",
    "{authority}",
    "{worktree}",
    "{scratch}"
  ],
  "write_roots": [
    "{worktree}",
    "{scratch}"
  ],
  "deny_write": [
    "{authority}"
  ],
  "seed_files": {
    "~/.codex/auth.json": ".codex/auth.json",
    "~/.codex/config.toml": ".codex/config.toml",
    "~/.claude/.credentials.json": ".claude/.credentials.json",
    "~/.claude/settings.json": ".claude/settings.json",
    "~/.claude.json": ".claude.json",
    "~/.gitconfig": ".gitconfig"
  },
  "optional_read_roots": [
    "~/.nvm/versions/node",
    "~/.local/share/claude"
  ],
  "deny_read": [
    "~/.ssh",
    "~/.cache/veldo",
    "~/.codex/auth.json",
    "~/.claude/.credentials.json"
  ]
}
