{
  "name": "cross-tenant read must be denied (deliberately failing against the vulnerable resource)",
  "base_url": "http://127.0.0.1:8080",
  "timeout": 5,
  "identities": {
    "bob": {"headers": {"Authorization": "Bearer bob-token"}}
  },
  "checks": [
    {
      "name": "a non-owner must not read another user's record",
      "as": "bob",
      "request": {"method": "GET", "path": "/leaky/orders/ord-1"},
      "expect": "deny",
      "deny_status": [403],
      "body_must_not_contain": ["owner-secret-9f3a"]
    }
  ]
}
