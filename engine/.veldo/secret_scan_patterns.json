{
 "schema": "veldo.secret_scan_patterns/v1",
 "note": "The product's generic list of credential formats the workspace and project-tree scan (secret_scan.scan, VELDO-0254 AC2) reports. Each entry is a kind and the regular expression of its format; the first entry that matches a span names it. Formats only: no value, account or service of any installation belongs here.",
 "formats": [
  {"kind": "private_key", "pattern": "-{5}BEGIN (?:[A-Z]+ )*PRIVATE KEY-{5}"},
  {"kind": "aws_access_key", "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"},
  {"kind": "github_token", "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,255}|github_pat_[A-Za-z0-9_]{22,255})\\b"},
  {"kind": "gitlab_token", "pattern": "\\bglpat-[A-Za-z0-9_\\-]{20,}"},
  {"kind": "slack_token", "pattern": "\\bxox[abposr]-[A-Za-z0-9\\-]{10,}"},
  {"kind": "stripe_key", "pattern": "\\b[rs]k_live_[A-Za-z0-9]{20,}"},
  {"kind": "google_api_key", "pattern": "\\bAIza[0-9A-Za-z_\\-]{35}\\b"},
  {"kind": "anthropic_key", "pattern": "\\bsk-ant-[A-Za-z0-9_\\-]{20,}"},
  {"kind": "openai_key", "pattern": "\\bsk-(?:proj-|svcacct-)?[A-Za-z0-9_\\-]{32,}"},
  {"kind": "npm_token", "pattern": "\\bnpm_[A-Za-z0-9]{36}\\b"},
  {"kind": "telegram_bot_token", "pattern": "\\b[0-9]{8,10}:AA[A-Za-z0-9_\\-]{33}\\b"},
  {"kind": "jwt", "pattern": "\\beyJ[A-Za-z0-9_\\-]{10,}\\.eyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}"},
  {"kind": "url_password", "pattern": "\\b[a-z][a-z0-9+.\\-]*://[^\\s:/@]+:[^\\s:/@]{8,}@"}
 ]
}
