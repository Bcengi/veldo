    {
      "pattern": "roles/*.yaml",
      "kind": "role"
    },
    {
      "pattern": "teams/*.yaml",
      "kind": "team"
    },
    {
      "pattern": "services/*.yaml",
      "kind": "service"
    },
    {
      "pattern": "connectors/*.yaml",
