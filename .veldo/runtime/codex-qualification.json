{
 "authentication": "the subscription login of the account profile CODEX_HOME names",
 "baseline": {
  "configuration": {
   "cli_auth_credentials_store": "file",
   "forced_login_method": "chatgpt",
   "project_doc_max_bytes": 0,
   "skills.bundled.enabled": false,
   "skills.include_instructions": false
  },
  "options": [
   "--ignore-user-config",
   "--ignore-rules",
   "--disable",
   "apps"
  ],
  "strip_names": [
   "CLAUDE_AGENT_SDK_MCP_NO_PREFIX"
  ],
  "strip_prefixes": [
   "CLAUDE",
   "CLAUDECODE",
   "AI_AGENT",
   "CODEX"
  ]
 },
 "engine": "codex",
 "environment": {
  "DISABLE_AUTOUPDATER": "1"
 },
 "executable": "vendor/x86_64-unknown-linux-musl/bin/codex",
 "flags": [
  "exec",
  "--json",
  "-c",
  "check_for_update_on_startup=false"
 ],
 "package": "@openai/codex",
 "package_version": "0.154.0-linux-x64",
 "rate_limit_windows": [
  "plan",
  "quota",
  "usage_limit",
  "workspace_credits",
  "workspace_spend_cap"
 ],
 "schema": "veldo.engine_qualification/v1",
 "session_environment": [
  "CODEX_ACCESS_TOKEN",
  "CODEX_APH",
  "CODEX_AUTH",
  "CODEX_BWRAP_SHA256",
  "CODEX_CA_CERTIFICARGO_HTTP_CAINFO",
  "CODEX_CA_CERTIFICATE",
  "CODEX_GITHUB_PERSONAL_ACCESS_TOKEN",
  "CODEX_HOH",
  "CODEX_HOME",
  "CODEX_MANAGED_PACKAGE_ROOT",
  "CODEX_MCP_PROTOCOL_VERSION",
  "CODEX_NON_INTERACTIVE",
  "CODEX_SAH",
  "CODEX_SQLITE_HOME",
  "CODEX_THH",
  "CODEX_THI",
  "CODEX_URL",
  "CODEX_VEH1",
  "CODEX_VEI"
 ],
 "sha256": "sha256:3188814c35471432d4123203e0eb38e5bddc60226e3d7ddf0e59e649ea140022",
 "terminal_protocol": {
  "events": [
   "error",
   "item.completed",
   "item.started",
   "item.updated",
   "thread.started",
   "turn.completed",
   "turn.failed",
   "turn.started"
  ],
  "failed": "turn.failed",
  "item_kinds": [
   "agent_message",
   "reasoning",
   "command_execution",
   "file_change",
   "mcp_tool_call",
   "web_search",
   "todo_list",
   "collab_tool_call",
   "error"
  ],
  "stream": "stdout, one JSON event per line",
  "terminal": "turn.completed"
 },
 "usage_units": [
  "invocations",
  "wall_seconds",
  "tokens",
  "messages"
 ],
 "version": "0.154.0"
}
